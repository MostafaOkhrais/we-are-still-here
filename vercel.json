{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/(.*).html", "destination": "/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/contact", "destination": "https://dnvjfaaxfydvujkqsdfu.supabase.co/functions/v1/submit-contact" },
    { "source": "/api/newsletter", "destination": "https://dnvjfaaxfydvujkqsdfu.supabase.co/functions/v1/subscribe-newsletter" },
    { "source": "/api/news", "destination": "https://dnvjfaaxfydvujkqsdfu.supabase.co/rest/v1/news_posts?select=id,title_ar,title_en,body_ar,body_en,category,event_date,location,published_at,created_at&published=eq.true&order=published_at.desc.nullslast&order=created_at.desc&limit=50" },
    { "source": "/api/auth/token", "destination": "https://dnvjfaaxfydvujkqsdfu.supabase.co/auth/v1/token" },
    { "source": "/api/auth/logout", "destination": "https://dnvjfaaxfydvujkqsdfu.supabase.co/auth/v1/logout" },
    { "source": "/api/rest/contact_messages", "destination": "https://dnvjfaaxfydvujkqsdfu.supabase.co/rest/v1/contact_messages" },
    { "source": "/api/rest/newsletter_subscribers", "destination": "https://dnvjfaaxfydvujkqsdfu.supabase.co/rest/v1/newsletter_subscribers" },
    { "source": "/api/rest/news_posts", "destination": "https://dnvjfaaxfydvujkqsdfu.supabase.co/rest/v1/news_posts" },
    { "source": "/maintenance", "destination": "/maintenance.html" }
  ],
  "headers": [
    {
      "source": "/api/news",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.tailwindcss.com 'unsafe-inline' 'sha256-6wD+saZiBlvuEBEORMqQcohtT+LCfk2db1kofde/UIE='; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://dnvjfaaxfydvujkqsdfu.supabase.co https://cdn.tailwindcss.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.tailwindcss.com 'unsafe-inline' 'sha256-6wD+saZiBlvuEBEORMqQcohtT+LCfk2db1kofde/UIE='; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://dnvjfaaxfydvujkqsdfu.supabase.co https://cdn.tailwindcss.com; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
