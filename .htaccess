# We Are Still Here | باقون — Apache / LiteSpeed (Hostinger) configuration.
# Mirrors vercel.json behavior for non-Vercel hosting.

AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .svg

RewriteEngine On

Options -Indexes

# --- 0) Never serve dotfiles / .git / hidden files ---
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# Contact-page CSP variant (must precede internal rewrites: env survives, URI does not)
RewriteCond %{REQUEST_URI} ^/contact/?$ [NC]
RewriteRule ^ - [E=CONTACTPAGE:1]

# --- 1) Never serve internal files ---
<Files "vercel.json">
  Require all denied
</Files>
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/supabase/.*
# Block archives (prevent source leak)
RedirectMatch 404 \.zip$
<FilesMatch "\.zip$">
  Require all denied
</FilesMatch>
# Admin page must never be cached
<Files "admin.html">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set X-Robots-Tag "noindex, nofollow"
</Files>
# Serve only minified JS (hide readable sources) - allow public configs and team data
RedirectMatch 404 ^/js/(?!tailwind-config\.js$|team-data\.js$|team\.js$).+(?<!\.min)\.js$

# --- 2) Clean URLs: browser .html -> clean (permanent) ---
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# --- 3) Same-origin API proxy (PHP keeps the upstream host secret) ---
RewriteRule ^api/(.*)$ api.php?__route=$1 [L,QSA]

# --- 4) Clean URLs: internal clean -> file ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([\w-]+)/?$ $1.html [L]

# --- 5) Security headers (mirrors _headers / vercel.json) ---
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.tailwindcss.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://dnvjfaaxfydvujkqsdfu.supabase.co https://cdn.tailwindcss.com; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; upgrade-insecure-requests" env=CONTACTPAGE
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.tailwindcss.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://dnvjfaaxfydvujkqsdfu.supabase.co https://cdn.tailwindcss.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" env=!CONTACTPAGE
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- 6) Static asset caching (conservative: filenames are not hashed) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
